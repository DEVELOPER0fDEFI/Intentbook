# Dry-run is the default. Leave INTENTBOOK_LIVE unset or set it to 0.
# Set it to 1 only when you intend to broadcast execute_intents.
# Live mode still refuses unless simulate_intents succeeds, the order is within
# 5 lots and 50 USDC, and the relayer variables below are set.
INTENTBOOK_LIVE=0

# Optional relayer. This account pays gas. Never commit the private key.
# NEAR_RELAYER_ACCOUNT=
# NEAR_RELAYER_PRIVATE_KEY=
# INTENTBOOK_EXECUTE_GAS=300000000000000

# Optional. Quotes work without it. A partner JWT uses the authenticated 1Click fee.
# Register at https://partners.near-intents.org
# ONECLICK_JWT=

# 1Click app fee. Works without a JWT. Fee is basis points. Recipient is an Intents account.
# No key: 1Click charges 0.25% (25 bps). With a key: 0.20% (20 bps).
# appFees are split 50/50, and 1Click keeps at least 20 bps.
# ONECLICK_APP_FEE_BPS=10
# ONECLICK_APP_FEE_RECIPIENT=

# NEAR_RPC_URL=https://rpc.mainnet.near.org
# INTENTS_CONTRACT=intents.near
# ONECLICK_BASE=https://1click.chaindefuser.com
# MM_INTERVAL_MS=45000

# SQLite file. On Vercel the filesystem is ephemeral, so the book resets with the instance.
# SQLITE_PATH=.data/intentbook.sqlite
